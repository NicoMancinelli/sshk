#!/bin/sh
# ssh-tailscale - wrapper around dbclient for connecting over Tailscale userspace mode

# Resolve our own directory with pure POSIX expansion: `cd`/`pwd` are shell
# builtins, so the wrapper can still find its sidecar files (sshk-common.sh,
# keys, dbclient) when PATH is empty or `dirname` is unavailable.
case "$0" in
    */*) BINDIR="${0%/*}" ;;
    *) BINDIR="." ;;
esac
BINDIR="$(cd "$BINDIR" && pwd)"
DBCLIENT="$BINDIR/dbclient"
CONF="$BINDIR/../hosts.conf"
# shellcheck disable=SC1091  # resolved via $BINDIR at runtime; linted standalone
. "$BINDIR/sshk-common.sh"

usage() {
    echo "Usage: ssh-tailscale [options] user@host[:port] [command]"
    echo ""
    echo "Connects via Tailscale userspace mode (no tun.ko required):"
    echo "  the SSH session is tunnelled through 'tailscale nc <host> <port>'."
    echo ""
    echo "Options:"
    echo "  -i <name|path>   Identity key. Name -> kindle_<name>_key."
    echo "  -p <port>        SSH port on the remote host (default 22)."
    echo "  -L/-R/-l <spec>  Forwarded through to dbclient."
    echo "  -h, --help       Show this help."
    echo ""
    _names=$(sshk_alias_names "$CONF")
    if [ -n "$_names" ]; then
        echo "Saved aliases (from $CONF):"
        printf '%s\n' "$_names" | sed 's/^/  /'
    else
        echo "No saved aliases yet - run 'ssh-menu' (or 'sshk') to add one."
    fi
}

if [ -z "$1" ]; then
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

# Known hosts probe (shared with the plain `ssh` wrapper via sshk-common.sh so
# Tailscale paths get the same MITM protection as LAN paths). Tailscale
# tailnets frequently host personal devices without unique usernames, so
# auto-accepting every host key here would be a regression. Tests force the
# auto-accept branch via SSHK_TEST_FORCE_AUTO_ACCEPT=1.
OPTS=$(sshk_known_hosts_flags)

PORT=22
HAS_I=0
TARGET=""
HOST=""

# Return values filled in by sshk_lookup_alias below; initialised so the shell
# never sees an unset read.
SSHK_ALIAS_HOST=""
SSHK_ALIAS_PORT=""
SSHK_ALIAS_KEY=""

COUNT=$#
i=0
while [ $i -lt $COUNT ]; do
    arg="$1"
    shift
    i=$((i + 1))
    
    case "$arg" in
        -i)
            if [ $i -lt $COUNT ]; then
                keyarg="$1"
                shift
                i=$((i + 1))
                set -- "$@" "-i" "$(sshk_map_identity "$keyarg" "$BINDIR")"
                HAS_I=1
            else
                set -- "$@" "-i"
            fi
            ;;
        -p)
            if [ $i -lt $COUNT ]; then
                PORT="$1"
                shift
                i=$((i + 1))
            fi
            ;;
        -L|-R|-l)
            set -- "$@" "$arg"
            if [ $i -lt $COUNT ]; then
                set -- "$@" "$1"
                shift
                i=$((i + 1))
            fi
            ;;
        -*)
            set -- "$@" "$arg"
            ;;
        *)
            TARGET="$arg"
            case "$TARGET" in
                *@*) 
                    HOST="${TARGET#*@}"
                    set -- "$@" "$TARGET"
                    ;;
                *)
                    if sshk_lookup_alias "$CONF" "$TARGET"; then
                        if [ -n "$SSHK_ALIAS_PORT" ]; then
                            PORT="$SSHK_ALIAS_PORT"
                        fi
                        if [ -n "$SSHK_ALIAS_KEY" ] && [ $HAS_I -eq 0 ]; then
                            AKEY=$(sshk_identity_path "$BINDIR" "$SSHK_ALIAS_KEY")
                            if [ -f "$AKEY" ]; then
                                set -- "$@" "-i" "$AKEY"
                                HAS_I=1
                            fi
                        fi
                        HOST="${SSHK_ALIAS_HOST#*@}"
                        set -- "$@" "$SSHK_ALIAS_HOST"
                    else
                        HOST="${TARGET#*@}"
                        set -- "$@" "$TARGET"
                    fi
                    ;;
            esac
            
            while [ $i -lt $COUNT ]; do
                set -- "$@" "$1"
                shift
                i=$((i + 1))
            done
            ;;
    esac
done

if [ -z "$HOST" ]; then
    echo "sshk: missing target" >&2
    exit 1
fi

if [ -f "/mnt/us/extensions/tailscale/bin/tailscale" ]; then
    TAILSCALE="/mnt/us/extensions/tailscale/bin/tailscale"
elif command -v tailscale >/dev/null 2>&1; then
    TAILSCALE="tailscale"
else
    echo "sshk: tailscale binary not found at /mnt/us/extensions/tailscale/bin/tailscale or in PATH" >&2
    exit 1
fi

if [ $HAS_I -eq 0 ]; then
    SSHK_NATIVE_OPTS=""
    sshk_native_key_opts "$BINDIR"
    if [ -n "$SSHK_NATIVE_OPTS" ]; then
        OPTS="$OPTS $SSHK_NATIVE_OPTS"
    fi
fi

# Inhibit screensaver while SSH is active (restores on exit)
sshk_inhibit_screensaver

"$DBCLIENT" $OPTS -J "$TAILSCALE nc $HOST $PORT" "$@"
EXIT_CODE=$?
exit $EXIT_CODE
