#!/bin/sh
# ssh-tailscale - wrapper around dbclient for connecting over Tailscale userspace mode

# Resolve our own directory with pure POSIX expansion: `cd`/`pwd` are shell
# builtins, so the wrapper can still find its sidecar files (sshk-common.sh,
# keys, dbclient) when PATH is empty or `dirname` is unavailable.
case "$0" in
    */*) BINDIR="${0%/*}" ;;
    *) BINDIR="." ;;
esac
BINDIR="$(cd "$BINDIR" && pwd)"
DBCLIENT="$BINDIR/dbclient"
CONF="$BINDIR/../hosts.conf"
# shellcheck disable=SC1091  # resolved via $BINDIR at runtime; linted standalone
. "$BINDIR/sshk-common.sh"

usage() {
    echo "Usage: ssh-tailscale [options] user@host[:port] [command]"
    echo ""
    echo "Connects via Tailscale userspace mode (no tun.ko required):"
    echo "  the SSH session is tunnelled through 'tailscale nc <host> <port>'."
    echo ""
    echo "Options:"
    echo "  -i <name|path>   Identity key. Name -> kindle_<name>_key."
    echo "  -p <port>        SSH port on the remote host (default 22)."
    echo "  -L/-R/-l <spec>  Forwarded through to dbclient."
    echo "  -h, --help       Show this help."
    echo ""
    _names=$(sshk_alias_names "$CONF")
    if [ -n "$_names" ]; then
        echo "Saved aliases (from $CONF):"
        printf '%s\n' "$_names" | sed 's/^/  /'
    else
        echo "No saved aliases yet - run 'ssh-menu' (or 'sshk') to add one."
    fi
}

if [ -z "$1" ]; then
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

# shellcheck disable=SC1091
. "$BINDIR/tailscale-common.sh"
PORT=""
HAS_I=0
TARGET=""
# Rotate processed options behind unprocessed arguments, preserving argv.
COUNT=$#
i=0
while [ "$i" -lt "$COUNT" ]; do
    arg=$1; shift; i=$((i + 1))
    case "$arg" in
        -i|-p|-L|-R|-l|-o)
            [ "$i" -lt "$COUNT" ] || { echo "sshk: $arg needs a value" >&2; exit 2; }
            value=$1; shift; i=$((i + 1))
            case "$arg" in
                -i) set -- "$@" -i "$(sshk_map_identity "$value" "$BINDIR")"; HAS_I=1 ;;
                -p) PORT=$value ;;
                *) set -- "$@" "$arg" "$value" ;;
            esac ;;
        -i?*) set -- "$@" -i "$(sshk_map_identity "${arg#-i}" "$BINDIR")"; HAS_I=1 ;;
        -p?*) PORT=${arg#-p} ;;
        -J*) echo 'sshk: -J is reserved for Tailscale transport' >&2; exit 2 ;;
        -*) set -- "$@" "$arg" ;;
        *)
            TARGET=$arg
            case "$TARGET" in *:) echo 'sshk: missing port after colon' >&2; exit 2 ;; esac
            if sshk_lookup_alias "$CONF" "$TARGET"; then
                TARGET=$SSHK_ALIAS_HOST
                PORT=${PORT:-$SSHK_ALIAS_PORT}
                if [ -n "$SSHK_ALIAS_KEY" ] && [ "$HAS_I" -eq 0 ]; then
                    set -- "$@" -i "$(sshk_identity_path "$BINDIR" "$SSHK_ALIAS_KEY")"
                    HAS_I=1
                fi
            else
                case "$TARGET" in
                    *:*)
                        PORT=${PORT:-${TARGET##*:}}
                        TARGET=${TARGET%:*} ;;
                esac
            fi
            HOST=${TARGET#*@}
            # DNS names and IPv4 are supported; reject ambiguous IPv6 syntax.
            case "$HOST" in
                ''|-*|*[!A-Za-z0-9._-]*) echo 'sshk: invalid Tailscale hostname (use a DNS name or IPv4)' >&2; exit 2 ;;
            esac
            set -- "$@" "$TARGET"
            while [ "$i" -lt "$COUNT" ]; do
                arg=$1; shift; set -- "$@" "$arg"; i=$((i + 1))
            done ;;
    esac
done
[ -n "$TARGET" ] || { echo 'sshk: missing target' >&2; exit 2; }
PORT=${PORT:-22}
case "$PORT" in ''|*[!0-9]*|??????*) echo 'sshk: invalid port' >&2; exit 2 ;; esac
# shellcheck disable=SC2015
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || { echo 'sshk: port must be 1-65535' >&2; exit 2; }
sshk_tailscale_find && sshk_tailscale_ready || exit 1
if [ "$HAS_I" -eq 0 ]; then
    sshk_native_key_opts "$BINDIR"
    [ ! -f "$BINDIR/kindle_native_key" ] || set -- -i "$BINDIR/kindle_native_key" "$@"
fi
HOST_FLAGS=$(sshk_known_hosts_flags)
[ -z "$HOST_FLAGS" ] || set -- "$HOST_FLAGS" "$@"
sshk_inhibit_screensaver
"$DBCLIENT" -p "$PORT" -J "$(sshk_tailscale_proxy "$HOST" "$PORT")" "$@"
exit $?
