#!/bin/sh
BINDIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$BINDIR/../hosts.conf"
SCP_BIN="$BINDIR/dropbearmulti"
SCP_SSH="$BINDIR/ssh"
# shellcheck disable=SC1091
. "$BINDIR/sshk-common.sh"
# Choose Tailscale when a saved remote endpoint requests it. Keep original
# argv untouched; scp-common resolves endpoints after transport selection.
_skip=0
for _arg do
    if [ "$_skip" -eq 1 ]; then _skip=0; continue; fi
    case "$_arg" in
        -[ciPoFSl]) _skip=1 ;;
        -*) ;;
        *)
            if sshk_lookup_alias "$CONF" "${_arg%%:*}"; then
                case "$SSHK_ALIAS_TRANSPORT" in
                    tailscale) SCP_SSH="$BINDIR/ssh-tailscale" ;;
                    direct) ;;
                    *) echo 'sshk: invalid saved transport; edit this host' >&2; exit 2 ;;
                esac
            fi ;;
    esac
done
: "$SCP_BIN" "$SCP_SSH" # consumed by sourced helper
# shellcheck disable=SC1091
. "$BINDIR/scp-common.sh"
