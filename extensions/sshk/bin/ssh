#!/bin/sh
# ssh - wrapper around dbclient for Kindle
# Resolve our own directory with pure POSIX expansion: `cd`/`pwd` are shell
# builtins, so the wrapper can still find its sidecar files (sshk-common.sh,
# keys, dbclient) when PATH is empty or `dirname` is unavailable.
case "$0" in
    */*) BINDIR="${0%/*}" ;;
    *) BINDIR="." ;;
esac
BINDIR="$(cd "$BINDIR" && pwd)"
CONF="$BINDIR/../hosts.conf"
# shellcheck disable=SC1091  # resolved via $BINDIR at runtime; linted standalone
. "$BINDIR/sshk-common.sh"

usage() {
    echo "Usage: ssh [options] user@host[:port] | <alias> [command]"
    echo ""
    echo "Examples:"
    echo "  ssh user@192.168.1.10"
    echo "  ssh -p 2222 user@host.example"
    echo "  ssh myserver         # alias from hosts.conf"
    echo ""
    echo "Options:"
    echo "  -i <name|path>   Identity key. Name -> kindle_<name>_key."
    echo "  -p <port>        SSH port on the remote host."
    echo "  -L/-R/-l <spec>  Forwarded through to dbclient."
    echo "  -h, --help       Show this help."
    echo ""
    _names=$(sshk_alias_names "$CONF")
    if [ -n "$_names" ]; then
        echo "Saved aliases (from $CONF):"
        printf '%s\n' "$_names" | sed 's/^/  /'
    else
        echo "No saved aliases yet - run 'ssh-menu' (or 'sshk') to add one."
    fi
}

# `ssh` with no arguments is the friendliest entry point: open the
# quick-connect picker when we have a terminal, otherwise print usage. This
# means the whole tool can be driven by typing just `ssh`.
if [ $# -eq 0 ]; then
    if [ -t 0 ] && [ -x "$BINDIR/ssh-menu" ]; then
        exec "$BINDIR/ssh-menu"
    fi
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [ -z "$1" ]; then
    usage
    exit 1
fi

# Known hosts check. The shared probe (sshk-common.sh) yields "-y" only when
# /root/.ssh/known_hosts cannot be created or written; tests force that branch
# via SSHK_TEST_FORCE_AUTO_ACCEPT=1.
OPTS=$(sshk_known_hosts_flags)

HAS_I=0

# Return values filled in by sshk_lookup_alias below; initialised so the shell
# never sees an unset read.
SSHK_ALIAS_HOST=""
SSHK_ALIAS_PORT=""
SSHK_ALIAS_KEY=""

COUNT=$#
i=0
while [ $i -lt $COUNT ]; do
    arg="$1"
    shift
    i=$((i + 1))
    
    case "$arg" in
        -i)
            if [ $i -lt $COUNT ]; then
                keyarg="$1"
                shift
                i=$((i + 1))
                set -- "$@" "-i" "$(sshk_map_identity "$keyarg" "$BINDIR")"
                HAS_I=1
            else
                set -- "$@" "-i"
            fi
            ;;
        -p|-L|-R|-l)
            set -- "$@" "$arg"
            if [ $i -lt $COUNT ]; then
                set -- "$@" "$1"
                shift
                i=$((i + 1))
            fi
            ;;
        -*)
            set -- "$@" "$arg"
            ;;
        *)
            TARGET="$arg"
            case "$TARGET" in
                *@*) 
                    set -- "$@" "$TARGET"
                    ;;
                *)
                    if sshk_lookup_alias "$CONF" "$TARGET"; then
                        if [ -n "$SSHK_ALIAS_PORT" ]; then
                            set -- "$@" "-p" "$SSHK_ALIAS_PORT"
                        fi
                        if [ -n "$SSHK_ALIAS_KEY" ] && [ $HAS_I -eq 0 ]; then
                            AKEY=$(sshk_identity_path "$BINDIR" "$SSHK_ALIAS_KEY")
                            if [ -f "$AKEY" ]; then
                                set -- "$@" "-i" "$AKEY"
                                HAS_I=1
                            fi
                        fi
                        set -- "$@" "$SSHK_ALIAS_HOST"
                    else
                        set -- "$@" "$TARGET"
                    fi
                    ;;
            esac
            
            while [ $i -lt $COUNT ]; do
                set -- "$@" "$1"
                shift
                i=$((i + 1))
            done
            ;;
    esac
done

if [ $HAS_I -eq 0 ]; then
    SSHK_NATIVE_OPTS=""
    sshk_native_key_opts "$BINDIR"
    if [ -n "$SSHK_NATIVE_OPTS" ]; then
        OPTS="$OPTS $SSHK_NATIVE_OPTS"
    fi
fi

# Inhibit screensaver while SSH is active (restores on exit)
sshk_inhibit_screensaver

"$BINDIR/dbclient" $OPTS "$@"
EXIT_CODE=$?
exit $EXIT_CODE
