#!/bin/sh
# ssh - wrapper around dbclient for Kindle
BINDIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$BINDIR/../hosts.conf"

if [ -z "$1" ]; then
    echo "Usage: ssh [options] user@host[:port] | <alias> [command]"
    echo ""
    echo "Examples:"
    echo "  ssh user@192.168.1.10"
    echo "  ssh -p 2222 user@host.example"
    echo "  ssh myserver         # alias from hosts.conf"
    echo ""
    echo "Options:"
    echo "  -i <name|path>   Identity key. Name -> kindle_<name>_key."
    echo "  -p <port>        SSH port on the remote host."
    echo "  -L/-R/-l <spec>  Forwarded through to dbclient."
    echo ""
    echo "Host aliases live in: $CONF"
    exit 1
fi

# Known hosts check. Tests force the auto-accept branch via
# SSHK_TEST_FORCE_AUTO_ACCEPT=1 so the probe can be exercised
# deterministically from a non-Kindle sandbox.
OPTS=""
if [ "${SSHK_TEST_FORCE_AUTO_ACCEPT:-0}" = "1" ]; then
    OPTS="-y"
elif [ -w "/root/.ssh/known_hosts" ] || touch /root/.ssh/known_hosts 2>/dev/null; then
    :
else
    OPTS="-y"
fi

HAS_I=0

COUNT=$#
i=0
while [ $i -lt $COUNT ]; do
    arg="$1"
    shift
    i=$((i + 1))
    
    case "$arg" in
        -i)
            if [ $i -lt $COUNT ]; then
                keyarg="$1"
                shift
                i=$((i + 1))
                case "$keyarg" in
                    */*) set -- "$@" "-i" "$keyarg" ;;
                    *) set -- "$@" "-i" "$BINDIR/kindle_${keyarg}_key" ;;
                esac
                HAS_I=1
            else
                set -- "$@" "-i"
            fi
            ;;
        -p|-L|-R|-l)
            set -- "$@" "$arg"
            if [ $i -lt $COUNT ]; then
                set -- "$@" "$1"
                shift
                i=$((i + 1))
            fi
            ;;
        -*)
            set -- "$@" "$arg"
            ;;
        *)
            TARGET="$arg"
            case "$TARGET" in
                *@*) 
                    set -- "$@" "$TARGET"
                    ;;
                *)
                    if [ -f "$CONF" ]; then
                        MATCH=$(grep -v '^[[:space:]]*#' "$CONF" | grep -v '^[[:space:]]*$' | awk -v a="$TARGET" '$1 == a {print; exit}')
                        if [ -n "$MATCH" ]; then
                            ALIAS_HOST=$(echo "$MATCH" | awk '{print $2}')
                            ALIAS_KEY=$(echo "$MATCH" | awk '{print $3}')
                            
                            case "$ALIAS_HOST" in
                                *:*)
                                    ALIAS_PORT="${ALIAS_HOST##*:}"
                                    ALIAS_HOST="${ALIAS_HOST%:*}"
                                    set -- "$@" "-p" "$ALIAS_PORT"
                                    ;;
                            esac
                            
                            if [ -n "$ALIAS_KEY" ] && [ $HAS_I -eq 0 ]; then
                                AKEY="$BINDIR/kindle_${ALIAS_KEY}_key"
                                if [ -f "$AKEY" ]; then
                                    set -- "$@" "-i" "$AKEY"
                                    HAS_I=1
                                fi
                            fi
                            set -- "$@" "$ALIAS_HOST"
                        else
                            set -- "$@" "$TARGET"
                        fi
                    else
                        set -- "$@" "$TARGET"
                    fi
                    ;;
            esac
            
            while [ $i -lt $COUNT ]; do
                set -- "$@" "$1"
                shift
                i=$((i + 1))
            done
            ;;
    esac
done

if [ $HAS_I -eq 0 ]; then
    KEY="$BINDIR/kindle_native_key"
    if [ ! -f "$KEY" ]; then
        echo "sshk: First run detected - generating default SSH key..."
        "$BINDIR/dropbearkey" -t ed25519 -f "$KEY" >/dev/null 2>&1
        if [ -f "$KEY" ]; then
            "$BINDIR/showkey.sh" "native" >/dev/null 2>&1
        fi
    fi
    if [ -f "$KEY" ]; then
        OPTS="$OPTS -i $KEY"
    fi
fi

# Inhibit screensaver while SSH is active (restores on exit)
if command -v lipc-set-prop >/dev/null 2>&1; then
    lipc-set-prop com.lab126.powerd preventScreenSaver 1 2>/dev/null || true
    cleanup() {
        # shellcheck disable=SC2317  # reached via signal trap, not a direct call
        lipc-set-prop com.lab126.powerd preventScreenSaver 0 2>/dev/null || true
    }
    trap cleanup EXIT INT TERM HUP
fi

"$BINDIR/dbclient" $OPTS "$@"
EXIT_CODE=$?
exit $EXIT_CODE
