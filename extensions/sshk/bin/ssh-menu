#!/bin/sh
# ssh-menu - Interactive SSH connection manager & picker for kterm on Kindle

BINDIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$BINDIR/../hosts.conf"

clear 2>/dev/null || echo ""

# Query system status if running on Kindle
STATUS_INFO=""
BATT_LEVEL=""
WIFI_INFO=""

if command -v lipc-get-prop >/dev/null 2>&1; then
    BATT_LEVEL=$(lipc-get-prop com.lab126.powerd battLevel 2>/dev/null)
    WIFI_SSID=$(lipc-get-prop com.lab126.wifid essid 2>/dev/null)
    if [ -n "$BATT_LEVEL" ]; then
        STATUS_INFO="Battery: ${BATT_LEVEL}%"
    fi
    if [ -n "$WIFI_SSID" ] && [ "$WIFI_SSID" != "null" ]; then
        STATUS_INFO="${STATUS_INFO:+$STATUS_INFO | }WiFi: $WIFI_SSID"
    fi
fi

# Fallback WiFi IP detection
if [ -z "$WIFI_INFO" ] && command -v ifconfig >/dev/null 2>&1; then
    IP=$(ifconfig wlan0 2>/dev/null | grep 'inet addr:' | cut -d: -f2 | awk '{print $1}')
    if [ -n "$IP" ]; then
        STATUS_INFO="${STATUS_INFO:+$STATUS_INFO | }IP: $IP"
    fi
fi

echo "=========================================="
echo "          ⚡ sshk: Quick Connect"
if [ -n "$STATUS_INFO" ]; then
    echo "  [ $STATUS_INFO ]"
fi
echo "=========================================="
echo ""

# ALIASES is a newline-separated list, in the order they were read from
# hosts.conf. Looking up by index via `sed -n "${n}p"` avoids `eval`, so a
# hosts.conf line containing shell metacharacters cannot trigger code
# execution when its alias is selected.
ALIASES=""
COUNT=0

if [ -f "$CONF" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        trimmed=$(echo "$line" | sed 's/^[ \t]*//')
        case "$trimmed" in
            \#*|"") continue ;;
            *)
                COUNT=$((COUNT + 1))
                alias_name=$(echo "$trimmed" | awk '{print $1}')
                alias_target=$(echo "$trimmed" | awk '{print $2}')
                alias_key=$(echo "$trimmed" | awk '{print $3}')

                key_info=""
                if [ -n "$alias_key" ]; then
                    key_info=" (key: $alias_key)"
                fi

                printf "  [%d] %-12s -> %s%s\n" "$COUNT" "$alias_name" "$alias_target" "$key_info"
                if [ -z "$ALIASES" ]; then
                    ALIASES="$alias_name"
                else
                    ALIASES="$ALIASES
$alias_name"
                fi
                ;;
        esac
    done < "$CONF"
fi

if [ "$COUNT" -eq 0 ]; then
    echo "  (No saved hosts in hosts.conf)"
    echo ""
fi

echo ""
echo "  [c] Custom SSH           [t] Custom Tailscale"
echo "  [a] Add Host Alias       [k] List SSH Keys"
echo "  [r] Refresh E-Ink Screen [q] Quit"
echo ""
printf "Enter choice: "
read -r choice

# Pull the alias name for the user's numeric choice without eval. An empty
# result means the choice was out of range.
selected_alias=""
case "$choice" in
    *[!0-9]*|"") : ;;  # non-numeric
    *)
        selected_alias=$(printf '%s\n' "$ALIASES" | sed -n "${choice}p" 2>/dev/null)
        ;;
esac

case "$choice" in
    q|Q|"")
        echo "Exiting."
        exit 0
        ;;
    r|R)
        "$BINDIR/eips-refresh"
        exec "$0"
        ;;
    k|K)
        echo ""
        "$BINDIR/listkeys.sh"
        echo ""
        printf "Press Enter to return to menu..."
        read -r _
        exec "$0"
        ;;
    a|A)
        echo ""
        echo "--- Add New Host Alias ---"
        printf "Alias name (e.g. myserver): "
        read -r new_alias
        if [ -z "$new_alias" ]; then
            echo "Cancelled."
            sleep 1
            exec "$0"
        fi

        printf "Connection target (user@host[:port]): "
        read -r new_target
        if [ -z "$new_target" ]; then
            echo "Cancelled."
            sleep 1
            exec "$0"
        fi

        printf "Custom key name (optional, press Enter for default): "
        read -r new_key

        entry="$new_alias $new_target"
        if [ -n "$new_key" ]; then
            entry="$entry $new_key"
        fi

        touch "$CONF"
        echo "$entry" >> "$CONF"
        echo "✓ Added '$new_alias' to hosts.conf!"
        sleep 1
        exec "$0"
        ;;
    c|C)
        echo ""
        printf "Enter target (user@host[:port]): "
        read -r custom_target
        if [ -n "$custom_target" ]; then
            exec "$BINDIR/ssh" "$custom_target"
        fi
        ;;
    t|T)
        echo ""
        printf "Enter Tailscale target (user@host[:port]): "
        read -r custom_target
        if [ -n "$custom_target" ]; then
            exec "$BINDIR/ssh-tailscale" "$custom_target"
        fi
        ;;
    *)
        if [ -n "$selected_alias" ]; then
            echo ""
            echo "Connecting to $selected_alias..."
            exec "$BINDIR/ssh" "$selected_alias"
        else
            echo "Invalid choice: '$choice'"
            sleep 1
            exec "$0"
        fi
        ;;
esac
