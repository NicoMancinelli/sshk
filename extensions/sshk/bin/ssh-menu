#!/bin/sh
# ssh-menu - Interactive SSH connection manager & picker for kterm on Kindle

# Same dirname-free directory resolution the connection wrappers use.
case "$0" in
    */*) BINDIR="${0%/*}" ;;
    *) BINDIR="." ;;
esac
BINDIR="$(cd "$BINDIR" && pwd)"
CONF="$BINDIR/../hosts.conf"

clear 2>/dev/null || echo ""

# Query system status if running on Kindle
STATUS_INFO=""
BATT_LEVEL=""
WIFI_INFO=""

if command -v lipc-get-prop >/dev/null 2>&1; then
    BATT_LEVEL=$(lipc-get-prop com.lab126.powerd battLevel 2>/dev/null)
    WIFI_SSID=$(lipc-get-prop com.lab126.wifid essid 2>/dev/null)
    if [ -n "$BATT_LEVEL" ]; then
        STATUS_INFO="Battery: ${BATT_LEVEL}%"
    fi
    if [ -n "$WIFI_SSID" ] && [ "$WIFI_SSID" != "null" ]; then
        STATUS_INFO="${STATUS_INFO:+$STATUS_INFO | }WiFi: $WIFI_SSID"
    fi
fi

# Fallback WiFi IP detection
if [ -z "$WIFI_INFO" ] && command -v ifconfig >/dev/null 2>&1; then
    IP=$(ifconfig wlan0 2>/dev/null | grep 'inet addr:' | cut -d: -f2 | awk '{print $1}')
    if [ -n "$IP" ]; then
        STATUS_INFO="${STATUS_INFO:+$STATUS_INFO | }IP: $IP"
    fi
fi

echo "=========================================="
echo "          ⚡ sshk: Quick Connect"
if [ -n "$STATUS_INFO" ]; then
    echo "  [ $STATUS_INFO ]"
fi
echo "=========================================="
echo ""

# ALIASES is a newline-separated list, in the order they were read from
# hosts.conf. Looking up by index via `sed -n "${n}p"` avoids `eval`, so a
# hosts.conf line containing shell metacharacters cannot trigger code
# execution when its alias is selected.
#
# Parsing uses pure shell parameter expansion (no sed/awk per line): a Kindle
# forks slowly, and a hosts.conf with a dozen entries made this menu crawl.
ALIASES=""
ALIAS_SET=""   # ":alias1:alias2:..." for forgiving name lookup without eval
COUNT=0

if [ -f "$CONF" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        # Trim leading whitespace, then skip comments and blank lines.
        line="${line#"${line%%[![:space:]]*}"}"
        case "$line" in
            ''|'#'*) continue ;;
        esac

        COUNT=$((COUNT + 1))

        alias_name="${line%%[[:space:]]*}"
        rest="${line#"$alias_name"}"
        rest="${rest#"${rest%%[![:space:]]*}"}"
        alias_target="${rest%%[[:space:]]*}"
        rest="${rest#"$alias_target"}"
        rest="${rest#"${rest%%[![:space:]]*}"}"
        alias_key="${rest%%[[:space:]]*}"

        key_info=""
        if [ -n "$alias_key" ]; then
            key_info=" (key: $alias_key)"
        fi

        printf "  [%d] %-12s -> %s%s\n" "$COUNT" "$alias_name" "$alias_target" "$key_info"
        ALIAS_SET="$ALIAS_SET:$alias_name"
        if [ -z "$ALIASES" ]; then
            ALIASES="$alias_name"
        else
            ALIASES="$ALIASES
$alias_name"
        fi
    done < "$CONF"
fi

if [ "$COUNT" -eq 0 ]; then
    echo "  (No saved hosts yet)"
    echo "  Press [a] to add your first host, or [c] to connect without saving."
    echo ""
fi

echo ""
echo "  [c] Custom SSH           [t] Custom Tailscale"
echo "  [a] Add Host Alias       [k] List SSH Keys"
echo "  [r] Refresh E-Ink Screen [q] Quit"
echo ""
printf "Enter choice: "
read -r choice

# Pull the alias name for the user's numeric choice without eval. An empty
# result means the choice was out of range.
selected_alias=""
case "$choice" in
    *[!0-9]*|"") : ;;  # non-numeric
    *)
        selected_alias=$(printf '%s\n' "$ALIASES" | sed -n "${choice}p" 2>/dev/null)
        ;;
esac

case "$choice" in
    q|Q|"")
        echo "Exiting."
        exit 0
        ;;
    r|R)
        "$BINDIR/eips-refresh"
        exec "$0"
        ;;
    k|K)
        echo ""
        "$BINDIR/listkeys.sh"
        echo ""
        printf "Press Enter to return to menu..."
        read -r _
        exec "$0"
        ;;
    a|A)
        echo ""
        echo "--- Add New Host Alias ---"
        printf "Alias name (e.g. myserver): "
        read -r new_alias
        case "$new_alias" in
            "")
                echo "Cancelled."
                sleep 1
                exec "$0"
                ;;
            *[!A-Za-z0-9_-]*)
                # Alias names are whitespace-separated from the target in
                # hosts.conf, so keep them to one safe token rather than
                # writing a line the parser would misread.
                echo "Alias may only contain letters, digits, '_' and '-'."
                sleep 2
                exec "$0"
                ;;
        esac

        printf "Connection target (user@host[:port]): "
        read -r new_target
        case "$new_target" in
            "")
                echo "Cancelled."
                sleep 1
                exec "$0"
                ;;
            *[[:space:]#]*)
                # Whitespace would split the line into the wrong fields, and
                # '#' would turn it into a comment. Anything else is preserved.
                echo "Target cannot contain spaces or '#'."
                sleep 2
                exec "$0"
                ;;
        esac

        printf "Custom key name (optional, press Enter for default): "
        read -r new_key

        entry="$new_alias $new_target"
        if [ -n "$new_key" ]; then
            entry="$entry $new_key"
        fi

        touch "$CONF"
        echo "$entry" >> "$CONF"
        echo "✓ Added '$new_alias' to hosts.conf!"
        sleep 1
        exec "$0"
        ;;
    c|C)
        echo ""
        printf "Enter target (user@host[:port]): "
        read -r custom_target
        if [ -n "$custom_target" ]; then
            exec "$BINDIR/ssh" "$custom_target"
        fi
        ;;
    t|T)
        echo ""
        printf "Enter Tailscale target (user@host[:port]): "
        read -r custom_target
        if [ -n "$custom_target" ]; then
            exec "$BINDIR/ssh-tailscale" "$custom_target"
        fi
        ;;
    *)
        if [ -n "$selected_alias" ]; then
            echo ""
            echo "Connecting to $selected_alias..."
            exec "$BINDIR/ssh" "$selected_alias"
        fi

        # Be forgiving: also accept the alias name typed in full, or a raw
        # user@host[:port] target, instead of only the menu number. The name
        # check is a ":name:" substring test -- no eval, and the name is quoted
        # so a metacharacter alias cannot inject a glob into the pattern.
        _direct=""
        case "${ALIAS_SET}:" in
            *":$choice:"*) _direct=1 ;;
        esac
        case "$choice" in
            *@*) _direct=1 ;;
        esac
        if [ -n "$_direct" ]; then
            echo ""
            echo "Connecting to $choice..."
            exec "$BINDIR/ssh" "$choice"
        fi

        echo "Invalid choice: '$choice'"
        sleep 1
        exec "$0"
        ;;
esac
